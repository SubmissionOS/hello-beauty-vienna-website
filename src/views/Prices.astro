---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PriceList from '../components/PriceList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { categories } from '../data/services';
import { href, SERVICE_PAGES, type RouteKey } from '../i18n/routes';
import type { Lang } from '../i18n/config';
import { t } from '../i18n';
import { crumbsFor, abs, serviceNode } from '../lib/schema';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const p = d.pricesPage;
const crumbs = crumbsFor('prices', lang, (k: RouteKey) => (k === 'home' ? d.nav.home : d.nav.prices));
const url = abs(href('prices', lang));
const schema = categories.map((c) =>
  serviceNode({
    url: `${url}#${c.id}`,
    name: d.cards[c.id].title,
    description: d.cards[c.id].text,
    lang,
    items: c.groups.flatMap((g) => g.items).map((x) => ({ name: x.name[lang], x })),
  }),
);
const navCss =
  categories
    .map((c, i) => `.prices:has(#${c.id}:target) .segmented--nav{--i:${i + 1}}.prices:has(#${c.id}:target) .segmented__opt[href="#${c.id}"] span{color:var(--c-ink)}`)
    .join('') + '.prices:not(:has(.price-cat:target)) .segmented__opt[href="#alle"] span{color:var(--c-ink)}';
---
<Base lang={lang} routeKey="prices" title={p.title} description={p.description} crumbs={crumbs} schema={schema} ogImage="salon-innenraum-ueberblick">
  <PageHeader lang={lang} eyebrow={p.eyebrow} title={p.h1} lead={p.lead} crumbs={crumbs} />

  <div class="prices">
    <div class="seg-bar">
      <div class="container">
        <div class="segmented-scroll">
          <nav class="segmented segmented--nav" aria-label={p.jump} style={`--n: ${categories.length + 1}`}>
            {
              (['all', ...categories.map((c) => c.id)] as const).map((id) => (
                <a class="segmented__opt" href={`#${id === 'all' ? 'alle' : id}`}>
                  <span>{p.tabs[id]}</span>
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
    {/* Sprungnavigation: der Indikator folgt dem angesprungenen Bereich (:target), ohne JavaScript */}
    <style is:inline set:html={navCss} />
  <div class="container price-page" id="alle">
    {
      categories.map((c) => (
        <section class="price-cat" id={c.id} data-cat={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="price-cat__head">
            <h2 id={`${c.id}-title`}>{d.cards[c.id].title}</h2>
            <a class="link-arrow" href={href(SERVICE_PAGES[c.id], lang)}>
              {d.cta.more}
              <span class="visually-hidden">: {d.cards[c.id].title}</span>
              <Icon name="arrow-right" />
            </a>
          </div>
          <PriceList lang={lang} groups={c.groups} idPrefix={`p-${c.id}`} />
        </section>
      ))
    }

    <div class="price-foot">
      <p class="small muted">{d.prices.vat}</p>
      <p class="small muted">{d.prices.duration}</p>
      <p class="small muted">{p.asOf}</p>
      <a class="btn btn--secondary btn--sm" href={site.priceListPdf} download>
        <Icon name="download" />
        {p.pdf}
      </a>
    </div>
  </div>

  </div>

  <CtaBand lang={lang} />
</Base>

<style>
  .seg-bar {
    position: sticky;
    top: calc(var(--header-h) + var(--safe-top));
    z-index: 20;
    padding-block: 10px;
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
  }
  .price-page {
    scroll-margin-top: calc(var(--header-h) + var(--safe-top) + 80px);
    padding-block: var(--s-7) var(--s-4);
    display: grid;
    gap: var(--s-9);
  }
  .price-page > * {
    max-width: 52rem;
  }
  .price-cat {
    scroll-margin-top: calc(var(--header-h) + var(--safe-top) + 80px);
  }
  .price-cat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    margin-bottom: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-gold-soft);
  }
  .price-foot {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
  .price-foot .btn {
    margin-top: var(--s-3);
  }
</style>
