---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery, type GalleryTag } from '../data/gallery';
import { image } from '../data/images';
import type { RouteKey } from '../i18n/routes';
import type { Lang } from '../i18n/config';
import { fmt, t } from '../i18n';
import { crumbsFor } from '../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const p = d.galleryPage;
const crumbs = crumbsFor('gallery', lang, (k: RouteKey) => (k === 'home' ? d.nav.home : d.nav.gallery));
const tags: ('all' | GalleryTag)[] = ['all', 'nails', 'pedicure', 'lashes', 'salon'];

const items = await Promise.all(
  gallery.map(async (g) => {
    const src = image(g.name);
    const w = (n: number) => Math.min(n, src.width);
    const [s, m, l] = await Promise.all([
      getImage({ src, width: w(800), format: 'webp', quality: 78 }),
      getImage({ src, width: w(1280), format: 'webp', quality: 78 }),
      getImage({ src, width: w(1800), format: 'webp', quality: 78 }),
    ]);
    return {
      ...g,
      alt: d.gallery[g.name as keyof typeof d.gallery],
      full: l.src,
      srcset: `${s.src} ${w(800)}w, ${m.src} ${w(1280)}w, ${l.src} ${w(1800)}w`,
      ratio: src.width / src.height,
    };
  }),
);
---
<Base lang={lang} routeKey="gallery" title={p.title} description={p.description} crumbs={crumbs} ogImage="naegel-rot-blumendesign">
  <PageHeader lang={lang} eyebrow={p.eyebrow} title={p.h1} lead={p.lead} crumbs={crumbs} />

  <section class="gallery-section" aria-label={p.h1}>
    <div class="container">
      <fieldset class="segmented" data-filter>
        <legend class="visually-hidden">{p.filterLabel}</legend>
        {
          tags.map((tag, i) => (
            <label class="segmented__opt">
              <input type="radio" name="gallery-filter" value={tag} checked={i === 0} />
              <span>{p.filters[tag]}</span>
            </label>
          ))
        }
      </fieldset>
      <p class="visually-hidden" role="status" data-filter-status data-label={p.shown}></p>

      <ul class="grid" role="list" data-gallery>
        {
          items.map((x, i) => (
            <li class="grid__item" data-tag={x.tag}>
              <button
                type="button"
                class="grid__btn"
                data-index={i}
                data-full={x.full}
                data-srcset={x.srcset}
                data-alt={x.alt}
                aria-label={fmt(p.open, { alt: x.alt })}
                aria-haspopup="dialog"
              >
                <Img name={x.name} alt="" ratio="1 / 1" sizes="(min-width: 1200px) 290px, (min-width: 768px) 31vw, 46vw" widths={[240, 360, 480, 640]} eager={i < 4} />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label={p.lightbox} data-counter={d.a11y.imageCount}>
    <div class="lightbox__top">
      <p class="lightbox__count" aria-live="polite" data-lb-count></p>
      <button type="button" class="lightbox__btn" data-lb-close aria-label={d.a11y.close}>
        <Icon name="close" />
      </button>
    </div>
    <figure class="lightbox__stage" data-lb-stage>
      <img data-lb-img alt="" sizes="100vw" draggable="false" />
      <figcaption class="lightbox__caption" data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev aria-label={d.a11y.previous}>
      <Icon name="chevron-left" />
    </button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next aria-label={d.a11y.next}>
      <Icon name="chevron-right" />
    </button>
  </dialog>

  <CtaBand lang={lang} />
</Base>

<script>
  import { fmtClient } from '../scripts/fmt';

  const grid = document.querySelector<HTMLElement>('[data-gallery]')!;
  const filter = document.querySelector<HTMLFieldSetElement>('[data-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const items = [...grid.querySelectorAll<HTMLLIElement>('li')];

  // Filter (Segmented Control); ohne JavaScript bleibt er verborgen und alle Bilder sind sichtbar
  if (filter) {
    filter.hidden = false;
    filter.addEventListener('change', () => {
      const v = filter.querySelector<HTMLInputElement>('input:checked')?.value ?? 'all';
      let n = 0;
      for (const li of items) {
        const show = v === 'all' || li.dataset.tag === v;
        li.hidden = !show;
        if (show) n++;
      }
      if (status) status.textContent = fmtClient(status.dataset.label ?? '{n}', { n });
    });
  }

  // Lightbox
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const caption = box.querySelector<HTMLElement>('[data-lb-caption]')!;
  const count = box.querySelector<HTMLElement>('[data-lb-count]')!;
  const counterLabel = box.dataset.counter ?? '';
  let list: HTMLButtonElement[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  const visibleButtons = () => items.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('button')!);

  function show(i: number) {
    index = (i + list.length) % list.length;
    const b = list[index]!;
    img.srcset = b.dataset.srcset ?? '';
    img.src = b.dataset.full ?? '';
    img.alt = b.dataset.alt ?? '';
    caption.textContent = b.dataset.alt ?? '';
    count.textContent = fmtClient(counterLabel, { current: index + 1, total: list.length });
  }

  function open(btn: HTMLButtonElement) {
    list = visibleButtons();
    opener = btn;
    show(list.indexOf(btn));
    box.showModal();
    requestAnimationFrame(() => box.classList.add('is-open'));
    box.querySelector<HTMLElement>('[data-lb-next]')?.focus();
  }

  function close() {
    box.classList.remove('is-open');
    box.close();
  }

  grid.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-index]');
    if (b) open(b);
  });
  box.addEventListener('close', () => opener?.focus());
  box.querySelector('[data-lb-close]')!.addEventListener('click', close);
  box.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
  box.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      show(index - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      show(index + 1);
    }
  });
  box.addEventListener('click', (e) => {
    if (e.target === box || (e.target as HTMLElement).matches('[data-lb-stage]')) close();
  });

  // Wischen links/rechts, nach unten schließen
  let x0 = 0;
  let y0 = 0;
  box.addEventListener('pointerdown', (e) => {
    x0 = e.clientX;
    y0 = e.clientY;
  });
  box.addEventListener('pointerup', (e) => {
    const dx = e.clientX - x0;
    const dy = e.clientY - y0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) close();
  });
</script>

<style>
  .gallery-section {
    padding-bottom: var(--section-y);
  }

  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0 0 var(--s-6);
    padding: 4px;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--c-cream);
    max-width: 100%;
    min-width: 0;
  }
  @media (scripting: none) {
    .segmented {
      display: none;
    }
  }
  @media (max-width: 559px) {
    .segmented {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(max-content, 1fr);
      gap: 2px;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .segmented::-webkit-scrollbar {
      display: none;
    }
  }
  .segmented__opt {
    position: relative;
    cursor: pointer;
  }
  .segmented__opt input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .segmented__opt span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    padding: 0 16px;
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-ink-muted);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  @media (max-width: 559px) {
    .segmented__opt span {
      padding: 0 10px;
      font-size: 0.875rem;
    }
  }
  .segmented__opt input:checked + span {
    background: var(--c-white);
    color: var(--c-ink);
    box-shadow: var(--sh-1);
  }
  .segmented__opt input:focus-visible + span {
    outline: 2px solid var(--c-gold-text);
    outline-offset: 2px;
  }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-2);
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--s-3);
    }
  }
  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .grid__item[hidden] {
    display: none;
  }
  .grid__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    overflow: hidden;
    cursor: zoom-in;
  }
  .grid__btn :global(.img) {
    border-radius: var(--r-md);
  }
  .grid__btn :global(img) {
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) {
    .grid__btn:hover :global(img) {
      transform: scale(1.04);
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 18 12 / 0.96);
    color: var(--c-white);
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    touch-action: pan-y;
  }
  .lightbox:global(.is-open) {
    opacity: 1;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__top {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--safe-top) + 8px) 12px 8px 20px;
  }
  .lightbox__count {
    font-size: var(--fs-small);
    color: var(--c-on-dark-muted);
    font-variant-numeric: tabular-nums;
  }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: var(--c-white);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .lightbox :global(:focus-visible) {
    outline-color: var(--c-accent);
    box-shadow: 0 0 0 3px #14120c;
  }
  .lightbox__stage {
    position: absolute;
    inset: calc(var(--safe-top) + 64px) 0 calc(var(--safe-bottom) + 72px);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    padding: 0 var(--s-4);
  }
  .lightbox__stage img {
    max-width: 100%;
    max-height: calc(100% - 3rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-sm);
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  .lightbox__caption {
    font-size: var(--fs-small);
    color: var(--c-on-dark-muted);
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__nav {
    position: absolute;
    bottom: calc(var(--safe-bottom) + 14px);
    z-index: 2;
  }
  .lightbox__nav--prev {
    left: calc(50% - 60px);
  }
  .lightbox__nav--next {
    right: calc(50% - 60px);
  }
  @media (min-width: 1024px) {
    .lightbox__nav {
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
    }
    .lightbox__nav--prev {
      left: 24px;
    }
    .lightbox__nav--next {
      right: 24px;
    }
    .lightbox__stage {
      inset: 72px 96px 40px;
    }
  }
</style>
