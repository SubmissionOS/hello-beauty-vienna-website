---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { gallery, type GalleryTag } from '../data/gallery';
import { image } from '../data/images';
import type { RouteKey } from '../i18n/routes';
import type { Lang } from '../i18n/config';
import { fmt, t } from '../i18n';
import { crumbsFor } from '../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const p = d.galleryPage;
const crumbs = crumbsFor('gallery', lang, (k: RouteKey) => (k === 'home' ? d.nav.home : d.nav.gallery));
const tags: ('all' | GalleryTag)[] = ['all', 'nails', 'pedicure', 'lashes', 'salon'];

const items = await Promise.all(
  gallery.map(async (g) => {
    const src = image(g.name);
    const w = (n: number) => Math.min(n, src.width);
    const [s, m, l] = await Promise.all([
      getImage({ src, width: w(800), format: 'webp', quality: 78 }),
      getImage({ src, width: w(1280), format: 'webp', quality: 78 }),
      getImage({ src, width: w(1800), format: 'webp', quality: 78 }),
    ]);
    return {
      ...g,
      alt: d.gallery[g.name as keyof typeof d.gallery],
      full: l.src,
      srcset: `${s.src} ${w(800)}w, ${m.src} ${w(1280)}w, ${l.src} ${w(1800)}w`,
      ratio: src.width / src.height,
    };
  }),
);
// Nach Bereichen gruppiert: mobil je ein Wischstreifen, am Desktop fließen alle Gruppen in ein Mosaik
const groupTags: GalleryTag[] = ['nails', 'pedicure', 'lashes', 'salon'];
let n = 0;
const groups = groupTags.map((tag) => ({
  tag,
  items: items
    .filter((x) => x.tag === tag)
    .map((x) => {
      const index = n++;
      // Mosaik-Rhythmus: breit (Querformat), hoch, sonst Standard
      const shape = x.ratio > 1.2 && index % 5 === 0 ? 'wide' : index % 7 === 3 ? 'tall' : 'std';
      return { ...x, index, shape };
    }),
}));
---
<Base lang={lang} routeKey="gallery" title={p.title} description={p.description} crumbs={crumbs} ogImage="naegel-rot-blumendesign">
  <PageHeader lang={lang} eyebrow={p.eyebrow} title={p.h1} lead={p.lead} crumbs={crumbs} />

  <section class="gallery-section" aria-label={p.h1}>
    <div class="container">
      <div class="segmented-scroll gallery-filter">
        <fieldset class="segmented" data-filter style={`--n: ${tags.length}`}>
          <legend class="visually-hidden">{p.filterLabel}</legend>
          {
            tags.map((tag, i) => (
              <label class="segmented__opt">
                <input type="radio" name="gallery-filter" value={tag} checked={i === 0} />
                <span>{p.filters[tag]}</span>
              </label>
            ))
          }
        </fieldset>
      </div>
      <p class="visually-hidden" role="status" data-filter-status data-label={p.shown}></p>

      <div class="gal" data-gallery>
        {
          groups.map((g) => (
            <section class="gal__group" aria-labelledby={`gal-${g.tag}`}>
              <h2 class="gal__title" id={`gal-${g.tag}`}>
                {p.filters[g.tag]} <span class="gal__count">{g.items.length}</span>
              </h2>
              <div class="gal__scroller" role="region" aria-labelledby={`gal-${g.tag}`} tabindex="0">
                <ul class="gal__list" role="list">
                  {g.items.map((x) => (
                    <li class:list={['grid__item', `grid__item--${x.shape}`]} data-tag={x.tag}>
                      <button
                        type="button"
                        class="grid__btn"
                        data-index={x.index}
                        data-full={x.full}
                        data-srcset={x.srcset}
                        data-alt={x.alt}
                        aria-label={fmt(p.open, { alt: x.alt })}
                        aria-haspopup="dialog"
                      >
                        <Img name={x.name} alt="" ratio="4 / 5" sizes="(min-width: 1200px) 300px, (min-width: 768px) 34vw, 70vw" widths={[240, 360, 480, 640]} eager={x.index < 3} />
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label={p.lightbox} data-counter={d.a11y.imageCount}>
    <div class="lightbox__top">
      <p class="lightbox__count" aria-live="polite" data-lb-count></p>
      <button type="button" class="lightbox__btn" data-lb-close aria-label={d.a11y.close}>
        <Icon name="close" />
      </button>
    </div>
    <figure class="lightbox__stage" data-lb-stage>
      <img data-lb-img alt="" sizes="100vw" draggable="false" />
      <figcaption class="lightbox__caption" data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev aria-label={d.a11y.previous}>
      <Icon name="chevron-left" />
    </button>
    <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next aria-label={d.a11y.next}>
      <Icon name="chevron-right" />
    </button>
  </dialog>

  <CtaBand lang={lang} />
</Base>

<script>
  import { fmtClient } from '../scripts/fmt';

  const grid = document.querySelector<HTMLElement>('[data-gallery]')!;
  const filter = document.querySelector<HTMLFieldSetElement>('[data-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const items = [...grid.querySelectorAll<HTMLLIElement>('li.grid__item')];

  // Filter (Segmented Control); ohne JavaScript bleibt er verborgen und alle Bilder sind sichtbar
  if (filter) {
    filter.hidden = false;
    filter.addEventListener('change', () => {
      const v = filter.querySelector<HTMLInputElement>('input:checked')?.value ?? 'all';
      let n = 0;
      for (const li of items) {
        const show = v === 'all' || li.dataset.tag === v;
        li.hidden = !show;
        if (show) n++;
      }
      if (status) status.textContent = fmtClient(status.dataset.label ?? '{n}', { n });
    });
  }

  // Lightbox
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = box.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const caption = box.querySelector<HTMLElement>('[data-lb-caption]')!;
  const count = box.querySelector<HTMLElement>('[data-lb-count]')!;
  const counterLabel = box.dataset.counter ?? '';
  let list: HTMLButtonElement[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  const visibleButtons = () => items.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('button')!);

  function show(i: number) {
    index = (i + list.length) % list.length;
    const b = list[index]!;
    img.srcset = b.dataset.srcset ?? '';
    img.src = b.dataset.full ?? '';
    img.alt = b.dataset.alt ?? '';
    caption.textContent = b.dataset.alt ?? '';
    count.textContent = fmtClient(counterLabel, { current: index + 1, total: list.length });
  }

  function open(btn: HTMLButtonElement) {
    list = visibleButtons();
    opener = btn;
    show(list.indexOf(btn));
    box.showModal();
    requestAnimationFrame(() => box.classList.add('is-open'));
    box.querySelector<HTMLElement>('[data-lb-next]')?.focus();
  }

  function close() {
    box.classList.remove('is-open');
    box.close();
  }

  grid.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-index]');
    if (b) open(b);
  });
  box.addEventListener('close', () => opener?.focus());
  box.querySelector('[data-lb-close]')!.addEventListener('click', close);
  box.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
  box.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      show(index - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      show(index + 1);
    }
  });
  box.addEventListener('click', (e) => {
    if (e.target === box || (e.target as HTMLElement).matches('[data-lb-stage]')) close();
  });

  // Wischen links/rechts, nach unten schließen
  let x0 = 0;
  let y0 = 0;
  box.addEventListener('pointerdown', (e) => {
    x0 = e.clientX;
    y0 = e.clientY;
  });
  box.addEventListener('pointerup', (e) => {
    const dx = e.clientX - x0;
    const dy = e.clientY - y0;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
    else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) close();
  });
</script>

<style>
  .gallery-section {
    padding-bottom: var(--section-y);
  }

  .gallery-filter {
    display: none;
    margin-bottom: var(--s-6);
  }
  @media (min-width: 768px) {
    .gallery-filter {
      display: block;
    }
  }
  @media (scripting: none) {
    .gallery-filter {
      display: none !important;
    }
  }

  /* Mobil: je Bereich ein horizontaler Streifen mit Scroll-Snap, das nächste Bild ist angeschnitten */
  .gal {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
  }
  .gal__title {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--fs-h3);
    margin-bottom: var(--s-3);
  }
  .gal__count {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .gal__scroller {
    margin-inline: calc(-1 * var(--gutter));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .gal__scroller::-webkit-scrollbar {
    display: none;
  }
  .gal__list {
    list-style: none;
    display: flex;
    gap: var(--s-2);
    width: max-content;
    padding-inline: var(--gutter);
  }
  .gal__list .grid__item {
    flex: none;
    width: 70vw;
    max-width: 20rem;
    scroll-snap-align: start;
  }

  /* Desktop: alle Gruppen fließen in ein dichtes Mosaik mit wechselnden Formaten */
  @media (min-width: 768px) {
    .gal {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 7rem;
      grid-auto-flow: dense;
      gap: var(--s-3);
    }
    .gal__group,
    .gal__scroller,
    .gal__list {
      display: contents;
    }
    .gal__title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .gal__list .grid__item {
      width: auto;
      max-width: none;
      grid-column: span 4;
      grid-row: span 3;
    }
    .gal__list .grid__item--wide {
      grid-column: span 8;
      grid-row: span 3;
    }
    .gal__list .grid__item--tall {
      grid-row: span 4;
    }
    .grid__btn,
    .grid__btn :global(.img) {
      height: 100%;
    }
    .grid__btn :global(.img) {
      aspect-ratio: auto !important;
    }
  }
  @media (min-width: 1200px) {
    .gal__list .grid__item {
      grid-column: span 3;
    }
    .gal__list .grid__item--wide {
      grid-column: span 6;
    }
  }
  .grid__item[hidden] {
    display: none;
  }
  .grid__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: none;
    overflow: hidden;
    cursor: zoom-in;
  }
  .grid__btn :global(.img) {
    border-radius: var(--r-md);
  }
  .grid__btn :global(img) {
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) {
    .grid__btn:hover :global(img) {
      transform: scale(1.04);
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 18 12 / 0.96);
    color: var(--c-white);
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    touch-action: pan-y;
  }
  .lightbox:global(.is-open) {
    opacity: 1;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox__top {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(var(--safe-top) + 8px) 12px 8px 20px;
  }
  .lightbox__count {
    font-size: var(--fs-small);
    color: var(--c-on-dark-muted);
    font-variant-numeric: tabular-nums;
  }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: var(--c-white);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .lightbox :global(:focus-visible) {
    outline-color: var(--c-accent);
    box-shadow: 0 0 0 3px #14120c;
  }
  .lightbox__stage {
    position: absolute;
    inset: calc(var(--safe-top) + 64px) 0 calc(var(--safe-bottom) + 72px);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    padding: 0 var(--s-4);
  }
  .lightbox__stage img {
    max-width: 100%;
    max-height: calc(100% - 3rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-sm);
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  .lightbox__caption {
    font-size: var(--fs-small);
    color: var(--c-on-dark-muted);
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__nav {
    position: absolute;
    bottom: calc(var(--safe-bottom) + 14px);
    z-index: 2;
  }
  .lightbox__nav--prev {
    left: calc(50% - 60px);
  }
  .lightbox__nav--next {
    right: calc(50% - 60px);
  }
  @media (min-width: 1024px) {
    .lightbox__nav {
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
    }
    .lightbox__nav--prev {
      left: 24px;
    }
    .lightbox__nav--next {
      right: 24px;
    }
    .lightbox__stage {
      inset: 72px 96px 40px;
    }
  }
</style>
