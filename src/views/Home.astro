---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import VisitCard from '../components/VisitCard.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import NailShapes from '../components/NailShapes.astro';
import SlotChip from '../components/SlotChip.astro';
import { href } from '../i18n/routes';
import type { Lang } from '../i18n/config';
import { LANG_META } from '../i18n/config';
import { fmt, t } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const nf = new Intl.NumberFormat(LANG_META[lang].intl);
const ratingValue = nf.format(site.rating.value);
const ratingCount = nf.format(site.rating.count);
const ratingDate = new Intl.DateTimeFormat(LANG_META[lang].intl, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(site.rating.asOf));
const faqExcerpt = [d.faqPage.groups[0]!.items[0]!, d.faqPage.groups[0]!.items[1]!, d.faqPage.groups[1]!.items[0]!, d.faqPage.groups[2]!.items[0]!];
// Galerie-Teaser: bewusst unterschiedliche Formate (Raum 16:9, Arbeiten 4:5, Detail 16:9)
const strip: { name: string; ratio: string; pos?: string }[] = [
  { name: 'salon-innenraum-ueberblick', ratio: '16 / 9' },
  { name: 'naegel-rot-blumendesign', ratio: '4 / 5', pos: '50% 60%' },
  { name: 'wimpern-volumen-ergebnis-blau', ratio: '4 / 5' },
  { name: 'pedikuere-french-haende-fuesse', ratio: '4 / 5' },
  { name: 'naegel-nude-goldornament', ratio: '16 / 9', pos: '50% 45%' },
];
---
<Base lang={lang} routeKey="home" title={h.title} description={h.description}>
  <section class="hero">
    <div class="hero__grid">
      <div class="hero__text">
        <p class="eyebrow">{h.hero.eyebrow}</p>
        <h1 class="hero__title">{h.hero.h1}</h1>
        <p class="hero__lead">{h.hero.lead}</p>
        <div class="hero__actions">
          <a class="btn" href={href('booking', lang)}>
            <Icon name="calendar" />
            {d.cta.bookNow}
          </a>
          <SlotChip lang={lang} />
        </div>
      </div>
      <div class="hero__media">
        <Img
          name="salon-empfang-hb-monogramm"
          alt={d.gallery['salon-empfang-hb-monogramm']}
          ratio="4 / 5"
          position="42% 50%"
          eager
          rounded={false}
          sizes="(min-width: 1024px) 48vw, 100vw"
          widths={[390, 520, 640, 800, 1000, 1200]}
        />
      </div>
    </div>
    <div class="container">
      <ul class="facts" role="list">
        <li>
          <span class="facts__k">{d.facts.location}</span>
          <span class="muted">{d.facts.nearby}</span>
        </li>
        <li>
          <span class="facts__k">{d.facts.hours}</span>
          <span class="muted">{d.hours.sunday} {d.hours.closed}</span>
        </li>
        <li>
          <span class="facts__k">{fmt(d.facts.ratingValue, { value: ratingValue })}</span>
          <span class="muted">{fmt(d.facts.ratingSource, { count: ratingCount, source: site.rating.source, date: ratingDate })}</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--white" id="leistungen" aria-labelledby="services-title">
    <div class="container">
      <div class="split-head">
        <div>
          <p class="eyebrow">{h.services.eyebrow}</p>
          <h2 id="services-title">{h.services.title}</h2>
        </div>
        <p class="split-head__intro">{h.services.intro}</p>
      </div>
      <ServiceIndex lang={lang} />
      <p class="end-link" id="preisliste">
        <a class="link-arrow" href={href('prices', lang)}>{d.cta.allPrices}<Icon name="arrow-right" /></a>
      </p>
    </div>
  </section>

  <div class="section section--cream">
    <div class="container">
      <NailShapes lang={lang} id="shapes-home" compact />
    </div>
  </div>

  <section class="section why-section" id="uberuns" aria-labelledby="why-title">
    <div class="why">
      <div class="why__media">
        <Img name="naegel-behandlung-arbeitsplatz" alt={d.gallery['naegel-behandlung-arbeitsplatz']} ratio="4 / 5" position="60% 50%" rounded={false} sizes="(min-width: 1024px) 46vw, 100vw" widths={[360, 540, 720, 960]} />
        <div class="why__detail">
          <Img name="naegel-milchweiss-mandel" alt={d.gallery['naegel-milchweiss-mandel']} ratio="1 / 1" position="50% 30%" sizes="(min-width: 1024px) 240px, 40vw" widths={[240, 360, 480]} />
        </div>
      </div>
      <div class="why__text">
        <p class="eyebrow">{h.why.eyebrow}</p>
        <h2 id="why-title">{h.why.title}</h2>
        <ul class="why__list" role="list">
          {
            h.why.items.map((x) => (
              <li>
                <h3>{x.title}</h3>
                <p>{x.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="glance-title">
    <div class="container glance">
      <div>
        <p class="eyebrow">{h.glance.eyebrow}</p>
        <h2 id="glance-title">{h.glance.title}</h2>
      </div>
      <div>
        <p class="glance__text">{h.glance.text}</p>
        <a class="rating" href={site.rating.url} target="_blank" rel="noopener noreferrer">
          <span class="rating__stars" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => <Icon name="star" size={16} />)}
          </span>
          <span>
            {fmt(d.facts.ratingValue, { value: ratingValue })} · {h.rating.link}
            <span class="visually-hidden">{d.a11y.newWindow}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="galerie" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">{h.gallery.eyebrow}</p>
          <h2 id="gallery-title">{h.gallery.title}</h2>
          <p>{h.gallery.text}</p>
        </div>
        <a class="link-arrow" href={href('gallery', lang)}>{d.cta.gallery}<Icon name="arrow-right" /></a>
      </div>
      <div class="strip" role="group" aria-label={h.gallery.text} tabindex="0">
        <ul class="mosaic" role="list">
          {
            strip.map((x, i) => (
              <li class:list={['mosaic__item', `mosaic__item--${i}`]}>
                <Img name={x.name} alt={d.gallery[x.name as keyof typeof d.gallery]} ratio={x.ratio} {...(x.pos ? { position: x.pos } : {})} sizes="(min-width: 1024px) 640px, 78vw" widths={[320, 480, 640, 960]} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--white" id="kontakt" aria-labelledby="visit-title">
    <div class="container visit">
      <div class="visit__text">
        <p class="eyebrow">{h.visit.eyebrow}</p>
        <h2 id="visit-title">{h.visit.title}</h2>
        <p class="muted">{h.visit.text}</p>
        <VisitCard lang={lang} id="home-visit" />
      </div>
      <div class="visit__media">
        <Img name="salon-schaufenster-barnabitengasse" alt={d.contactPage.storefrontAlt} ratio="4 / 5" position="35% 50%" sizes="(min-width: 1024px) 480px, 92vw" widths={[360, 540, 720, 960]} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-split">
      <div>
        <p class="eyebrow">{h.faq.eyebrow}</p>
        <h2 id="faq-title">{h.faq.title}</h2>
        <p class="faq-split__link">
          <a class="link-arrow" href={href('faq', lang)}>{d.cta.faq}<Icon name="arrow-right" /></a>
        </p>
      </div>
      <FaqList lang={lang} items={faqExcerpt} />
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  /* ---------- Hero: zweispaltiges Grid, Text und Foto teilen sich eine Spaltengrenze ----------
     Ursache des früheren Fehlers: Das Foto war absolut positioniert, die Überschrift hing mit max-width in ch
     (bezogen auf die eigene Schriftgröße) im Container – beide wussten nichts voneinander, und eine längere
     Überschrift (DE/EN) lief ins Foto. Jetzt: eine Spalte, in der der Text bleibt, Schrift an ihre Breite gebunden. */
  .hero {
    padding-bottom: var(--s-7);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .hero__text {
    /* Container für cqi: die Schriftgröße richtet sich nach der Spaltenbreite */
    container-type: inline-size;
    min-width: 0;
    padding: var(--s-5) var(--gutter) 0;
  }
  .hero__media {
    order: -1;
    min-width: 0;
  }
  .hero__media :global(.img) {
    aspect-ratio: auto !important;
    height: min(118vw, 62svh);
    min-height: 320px;
  }
  .hero__title {
    /* 23cqi: das längste Wort der Überschrift in DE/EN/HU („Gepflegte“, 4,14 em) passt mit Reserve in die Spalte */
    font-size: min(23cqi, var(--fs-display));
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-top: var(--s-3);
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .hero__lead {
    margin-top: var(--s-5);
    max-width: 34rem;
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.55;
    color: var(--c-ink-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-6);
  }
  @media (max-width: 479px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      /* linke Kante bündig mit dem Seiteninhalt, das Foto läuft rechts bis zum Rand */
      padding-left: max(var(--gutter), calc((100% - var(--container)) / 2));
      min-height: clamp(540px, 80svh, 840px);
    }
    .hero__text {
      align-self: center;
      padding: var(--s-8) var(--s-7) var(--s-8) 0;
    }
    .hero__media {
      order: 0;
    }
    .hero__media :global(.img) {
      height: 100%;
      min-height: 0;
    }
  }

  .facts {
    list-style: none;
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-ink);
    font-size: var(--fs-small);
    line-height: 1.45;
  }
  @media (min-width: 768px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-6);
    }
  }
  .facts__k {
    display: block;
    font-weight: 500;
    color: var(--c-ink);
  }
  .facts .muted {
    display: block;
  }

  /* ---------- Leistungen ---------- */
  .split-head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-7);
  }
  .split-head__intro {
    color: var(--c-ink-muted);
    font-size: var(--fs-lead);
    font-weight: 300;
    max-width: 30rem;
  }
  @media (min-width: 1024px) {
    .split-head {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--s-8);
    }
  }
  .end-link {
    margin-top: var(--s-6);
    text-align: right;
  }

  /* ---------- Warum: großes Bild am linken Rand, Detail überlappt ---------- */
  .why {
    display: grid;
    gap: var(--s-8);
  }
  .why__media {
    position: relative;
    margin-right: 18%;
  }
  .why__media > :global(.img) {
    aspect-ratio: 4 / 5 !important;
  }
  .why__detail {
    position: absolute;
    right: -22%;
    bottom: -12%;
    width: 46%;
    border: 6px solid var(--c-paper);
    border-radius: calc(var(--r-md) + 6px);
  }
  .why__text {
    padding-inline: var(--gutter);
  }
  .why__list {
    list-style: none;
    display: grid;
    gap: var(--s-6) var(--s-6);
    margin-top: var(--s-7);
  }
  .why__list li {
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-gold-soft);
  }
  .why__list h3 {
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .why__list p {
    margin-top: var(--s-2);
    color: var(--c-ink-muted);
  }
  @media (min-width: 640px) {
    .why__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .why {
      grid-template-columns: 44vw minmax(0, 1fr);
      gap: var(--s-9);
      align-items: center;
      padding-right: max(var(--gutter), calc((100vw - var(--container)) / 2));
    }
    .why__media {
      margin-right: 0;
    }
    .why__detail {
      right: -64px;
      bottom: -48px;
      width: 220px;
    }
    .why__text {
      padding-inline: 0;
    }
  }

  /* ---------- Auf einen Blick ---------- */
  .glance {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 1024px) {
    .glance {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--s-8);
    }
  }
  .glance__text {
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.6;
    max-width: 44rem;
  }
  .rating {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-5);
    min-height: var(--tap);
    font-weight: 500;
  }
  .rating__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--c-gold);
  }
  .rating__stars :global(svg) {
    fill: var(--c-accent);
  }

  /* ---------- Galerie: mobil Scroll-Snap-Streifen, Desktop Mosaik ---------- */
  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: none;
  }
  .section-head--row > div {
    max-width: 40rem;
  }
  .section-head--row p:not(.eyebrow) {
    margin-top: var(--s-3);
    color: var(--c-ink-muted);
  }
  .strip {
    margin-inline: calc(-1 * var(--gutter));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .mosaic {
    list-style: none;
    display: flex;
    gap: var(--s-3);
    padding-inline: var(--gutter);
    width: max-content;
  }
  .mosaic__item {
    flex: none;
    width: 74vw;
    max-width: 22rem;
    scroll-snap-align: start;
  }
  .mosaic__item :global(.img) {
    aspect-ratio: 4 / 5 !important;
  }
  @media (min-width: 1024px) {
    .strip {
      margin-inline: 0;
      overflow: visible;
    }
    .mosaic {
      display: grid;
      width: auto;
      padding: 0;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: 7.5rem;
      gap: var(--s-4);
    }
    .mosaic__item {
      width: auto;
      max-width: none;
    }
    .mosaic__item :global(.img) {
      aspect-ratio: auto !important;
      height: 100%;
    }
    .mosaic__item--0 {
      grid-column: 1 / 8;
      grid-row: span 3;
    }
    .mosaic__item--1 {
      grid-column: 8 / 13;
      grid-row: span 4;
    }
    .mosaic__item--2 {
      grid-column: 1 / 4;
      grid-row: span 3;
    }
    .mosaic__item--3 {
      grid-column: 4 / 8;
      grid-row: span 3;
    }
    .mosaic__item--4 {
      grid-column: 8 / 13;
      grid-row: span 2;
    }
  }

  /* ---------- Besuch ---------- */
  .visit {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .visit {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--s-9);
    }
  }
  .visit__text > .muted {
    margin: var(--s-4) 0 var(--s-5);
  }
  @media (max-width: 1023px) {
    .visit__media :global(.img) {
      aspect-ratio: 16 / 9 !important;
    }
  }

  /* ---------- FAQ ---------- */
  .faq-split {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 1024px) {
    .faq-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      gap: var(--s-8);
      align-items: start;
    }
  }
  .faq-split__link {
    margin-top: var(--s-4);
  }
</style>
