---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Img from './Img.astro';
import '../styles/mega.css';
import { image } from '../data/images';
import { href, routes, SERVICE_PAGES, type RouteKey } from '../i18n/routes';
import { LANG_META, type Lang } from '../i18n/config';
import { t } from '../i18n';
import { categories } from '../data/services';
import { shortTitle } from '../lib/menu';
import { demoMode, portalUrl } from '../lib/env';

interface Props {
  lang: Lang;
  routeKey: RouteKey | null;
}
const { lang, routeKey } = Astro.props;
const d = t(lang);
const current = (k: RouteKey) => routeKey === k;
const inServices = routeKey === 'services' || (routeKey !== null && routes[routeKey].parent === 'services');
const links: { key: RouteKey; label: string }[] = [
  { key: 'prices', label: d.nav.prices },
  { key: 'gallery', label: d.nav.gallery },
  { key: 'about', label: d.nav.about },
  { key: 'contact', label: d.nav.contact },
];
---
<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a class="brand" href={href('home', lang)} aria-label={d.a11y.homeLink}>
      <Image
        src={image('logo-hb-hello-beauty-quer-gold')}
        alt=""
        width={180}
        height={40}
        densities={[1, 2, 3]}
        format="webp"
        loading="eager"
        class="brand__logo"
      />
    </a>

    <nav class="desk-nav" aria-label={d.a11y.mainNav}>
      <ul class="desk-nav__list">
        <li class="desk-nav__item desk-nav__item--has-sub">
          <button
            type="button"
            class="desk-nav__link desk-nav__toggle"
            aria-expanded="false"
            aria-controls="mega-services"
            data-mega-trigger
            aria-current={inServices ? 'true' : undefined}
          >
            {d.nav.services}
            <Icon name="chevron-down" size={16} />
          </button>
          <div class="mega" id="mega-services" data-mega-panel>
            <div class="container mega__inner">
              <ul class="mega__grid" role="list">
                {
                  categories.map((c) => (
                    <li class="mega__col">
                      <p class="mega__title">
                        <a href={href(SERVICE_PAGES[c.id], lang)} aria-current={current(SERVICE_PAGES[c.id]) ? 'page' : undefined}>
                          {d.cards[c.id].title}
                        </a>
                      </p>
                      <p class="mega__desc">{d.mega.desc[c.id]}</p>
                      <ul class="mega__subs" role="list">
                        {c.groups.map((g) => (
                          <li>
                            <a href={`${href('prices', lang)}#p-${c.id}-${g.id}`}>{shortTitle(g.title[lang])}</a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))
                }
              </ul>
              <div class="mega__teaser">
                <a class="mega__photo" href={href('services', lang)} tabindex="-1" aria-hidden="true">
                  <Img name="salon-innenraum-ueberblick" alt="" ratio="4 / 3" position="40% 50%" sizes="304px" widths={[320, 480, 640]} />
                </a>
                <a class="link-arrow mega__all" href={href('services', lang)} aria-current={current('services') ? 'page' : undefined}>
                  {d.mega.all}
                  <Icon name="arrow-right" />
                </a>
                <a class="btn btn--block" href={href('booking', lang)}>
                  <Icon name="calendar" />
                  {d.nav.book}
                </a>
              </div>
            </div>
          </div>
        </li>
        {
          links.map((l) => (
            <li class="desk-nav__item">
              <a class="desk-nav__link" href={href(l.key, lang)} aria-current={current(l.key) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <button type="button" class="lang-btn" data-open="lang-sheet" aria-haspopup="dialog" aria-label={`${d.a11y.chooseLanguage} – ${d.a11y.currentLanguage}`}>
        <img src={`/flags/${LANG_META[lang].flag}.svg`} alt="" width="21" height="14" class="flag" />
        <span class="lang-btn__name" aria-hidden="true">{LANG_META[lang].label}</span>
        <Icon name="chevron-down" size={14} class="lang-btn__chev" />
      </button>
      {
        demoMode ? (
          <button type="button" class="login-btn" data-open="portal-sheet" aria-haspopup="dialog">
            <Icon name="user" size={20} />
            <span class="login-btn__label">{d.nav.login}</span>
          </button>
        ) : (
          <a class="login-btn" href={portalUrl(lang)}>
            <Icon name="user" size={20} />
            <span class="login-btn__label">{d.nav.login}</span>
          </a>
        )
      }
      <a class="btn btn--sm header-book" href={href('booking', lang)}>{d.nav.book}</a>
      <button type="button" class="menu-btn" data-open="menu-sheet" aria-haspopup="dialog" aria-label={d.a11y.openMenu}>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>
<div class="mega-scrim" data-mega-scrim aria-hidden="true"></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: var(--safe-top);
    background: var(--c-paper);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .site-header {
      background: color-mix(in srgb, var(--c-paper) 82%, transparent);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .site-header {
      background: var(--c-paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* Menü offen: Leiste und Panel bilden eine ruhige, deckende Fläche */
  .site-header:global(.is-mega-open) {
    background: var(--c-paper);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  :global(.is-scrolled) .site-header,
  .site-header:global(.is-scrolled) {
    border-bottom-color: var(--c-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: var(--header-h);
  }

  .brand {
    display: flex;
    flex: none;
    align-items: center;
    min-height: var(--tap);
    margin-right: auto;
    border-radius: var(--r-sm);
  }

  .brand :global(.brand__logo) {
    width: auto;
    height: 30px;
  }

  @media (min-width: 1024px) {
    .brand :global(.brand__logo) {
      height: 38px;
    }
  }

  .site-header__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--s-2);
    margin-left: auto;
  }

  .lang-btn,
  .login-btn,
  .menu-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--c-ink);
    font-size: var(--fs-small);
    font-weight: 500;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .lang-btn:hover,
  .login-btn:hover,
  .menu-btn:hover {
    background: var(--c-cream);
  }

  .lang-btn:active,
  .login-btn:active,
  .menu-btn:active {
    background: var(--c-line);
  }

  /* 3:2 wie die SVGs – keine Verzerrung */
  .flag {
    width: 21px;
    height: 14px;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(43 38 24 / 0.12);
  }

  .login-btn {
    text-decoration: none;
  }
  .login-btn:hover {
    color: var(--c-ink);
  }
  /* Unter 1280 px nur das Symbol (Name bleibt für Screenreader), ab 1280 px sekundärer Outline-Button */
  .login-btn__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (min-width: 1280px) {
    .login-btn {
      padding: 0 16px 0 14px;
      border-color: var(--c-field);
    }
    .login-btn__label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  .header-book {
    display: none;
  }

  /* Navigation und Aktionen brechen nie um, Symbole schrumpfen nicht */
  .desk-nav__link,
  .header-book,
  .lang-btn,
  .login-btn {
    white-space: nowrap;
  }
  .lang-btn :global(svg),
  .desk-nav__toggle :global(svg),
  .login-btn :global(svg) {
    flex: none;
  }

  .desk-nav {
    display: none;
  }

  /* Schmale Handys: Logo, Sprache, Login und Menü müssen in eine Zeile */
  @media (max-width: 399px) {
    .site-header__inner {
      gap: var(--s-2);
    }
    .site-header__actions {
      gap: 0;
    }
    .lang-btn {
      padding: 0 8px;
    }
    .lang-btn :global(.lang-btn__chev) {
      display: none;
    }
    .brand :global(.brand__logo) {
      height: 26px;
    }
  }
  @media (max-width: 339px) {
    .lang-btn__name {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    /* Reicht der Platz bei sehr langen Texten nicht, bricht der Aktionsblock in eine zweite Zeile um, statt zu überlappen */
    .site-header__inner {
      flex-wrap: wrap;
      height: auto;
      min-height: var(--header-h);
      align-content: center;
    }
    .menu-btn {
      display: none;
    }
    .header-book {
      display: inline-flex;
    }
    .desk-nav {
      display: block;
      margin-right: auto;
    }
    .brand {
      margin-right: var(--s-5);
    }
  }

  /* 1024–1179 px: kompakter, damit Logo, Navigation, Sprache, Login und Buchen in eine Zeile passen */
  @media (min-width: 1024px) and (max-width: 1179px) {
    .site-header__inner {
      gap: var(--s-3);
    }
    .brand {
      margin-right: var(--s-3);
    }
    .brand :global(.brand__logo) {
      height: 32px;
    }
    .desk-nav__link {
      padding: 0 9px;
      font-size: 0.9375rem;
    }
  }

  .desk-nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .desk-nav__item {
    position: relative;
  }

  .desk-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: var(--tap);
    padding: 0 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--c-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .desk-nav__link:hover {
    background: var(--c-cream);
    color: var(--c-ink);
  }

  .desk-nav__link[aria-current] {
    color: var(--c-gold-text);
    font-weight: 500;
  }

  .desk-nav__toggle :global(svg) {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .desk-nav__toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

</style>
