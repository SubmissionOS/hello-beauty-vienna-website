---
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import type { Lang } from '../i18n/config';
import type { QA } from '../i18n/types';

interface Props {
  lang: Lang;
  items: readonly QA[];
}
const { lang, items } = Astro.props;
---
<div class="faq">
  {
    items.map((x) => (
      <details class="faq__item">
        <summary>
          <span>{x.q}</span>
          <Icon name="plus" size={20} class="faq__icon" />
        </summary>
        <div class="faq__answer">
          <Rich text={x.a} lang={lang} />
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    background: var(--c-white);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-1);
    overflow: hidden;
  }
  .faq__item + .faq__item {
    border-top: 1px solid var(--c-line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 56px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    line-height: 1.4;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--c-paper);
  }
  summary:focus-visible {
    outline-offset: -3px;
  }
  .faq :global(.faq__icon) {
    flex: none;
    color: var(--c-gold-text);
    transition: transform var(--dur-2) var(--ease-out);
  }
  details[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }
  .faq__answer {
    padding: 0 18px 18px;
    color: var(--c-ink-muted);
    max-width: 70ch;
  }
</style>
