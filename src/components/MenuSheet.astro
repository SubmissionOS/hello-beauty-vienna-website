---
import Sheet from './Sheet.astro';
import Icon from './Icon.astro';
import { href, SERVICE_PAGES, type RouteKey } from '../i18n/routes';
import type { Lang } from '../i18n/config';
import { t } from '../i18n';
import { categories } from '../data/services';
import { shortTitle } from '../lib/menu';
import { site } from '../data/site';
import { demoMode, portalUrl } from '../lib/env';

interface Props {
  lang: Lang;
  routeKey: RouteKey | null;
}
const { lang, routeKey } = Astro.props;
const d = t(lang);
const cur = (k: RouteKey) => (routeKey === k ? 'page' : undefined);
const main: { key: RouteKey; label: string }[] = [
  { key: 'home', label: d.nav.home },
  { key: 'prices', label: d.nav.prices },
  { key: 'gallery', label: d.nav.gallery },
  { key: 'about', label: d.nav.about },
  { key: 'contact', label: d.nav.contact },
  { key: 'faq', label: d.nav.faq },
];
---
<Sheet id="menu-sheet" title={d.a11y.menu} closeLabel={d.a11y.closeMenu} size="large">
  <nav aria-label={d.a11y.mainNav} class="menu">
    <a class="btn btn--block" href={href('booking', lang)}>
      <Icon name="calendar" />
      {d.nav.book}
    </a>

    <details class="menu-acc">
      <summary class="menu-acc__summary">
        <span>{d.nav.services}</span>
        <Icon name="chevron-down" size={20} class="menu-acc__chev" />
      </summary>
      <div class="menu-acc__body">
        <ul class="menu-acc__list" role="list">
          {
            categories.map((c) => (
              <li class="menu-acc__item">
                <a class="menu-acc__main" href={href(SERVICE_PAGES[c.id], lang)} aria-current={cur(SERVICE_PAGES[c.id])}>
                  <span class="menu-acc__title">{d.cards[c.id].title}</span>
                  <span class="menu-acc__desc">{d.mega.desc[c.id]}</span>
                </a>
                <ul class="menu-acc__subs" role="list">
                  {c.groups.map((g) => (
                    <li>
                      <a href={`${href('prices', lang)}#p-${c.id}-${g.id}`}>{shortTitle(g.title[lang])}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow menu-acc__all" href={href('services', lang)} aria-current={cur('services')}>
          {d.mega.all}
          <Icon name="arrow-right" />
        </a>
      </div>
    </details>

    <p class="menu__label">Hello Beauty</p>
    <ul class="cells" role="list">
      {
        main.map((m) => (
          <li>
            <a class="cell" href={href(m.key, lang)} aria-current={cur(m.key)}>
              <span class="cell__body">
                <span class="cell__title">{m.label}</span>
              </span>
              <Icon name="chevron-right" class="cell__chevron" />
            </a>
          </li>
        ))
      }
    </ul>

    <ul class="cells menu__contact" role="list">
      <li>
        {
          demoMode ? (
            <button type="button" class="cell" data-open="portal-sheet" aria-haspopup="dialog">
              <span class="cell__icon">
                <Icon name="user" />
              </span>
              <span class="cell__body">
                <span class="cell__title">{d.nav.login}</span>
              </span>
              <Icon name="chevron-right" class="cell__chevron" />
            </button>
          ) : (
            <a class="cell" href={portalUrl(lang)}>
              <span class="cell__icon">
                <Icon name="user" />
              </span>
              <span class="cell__body">
                <span class="cell__title">{d.nav.login}</span>
              </span>
              <Icon name="chevron-right" class="cell__chevron" />
            </a>
          )
        }
      </li>
      <li>
        <a class="cell" href={`tel:${site.phoneE164}`}>
          <span class="cell__icon"><Icon name="phone" /></span>
          <span class="cell__body">
            <span class="cell__title">{site.phone}</span>
            <span class="cell__sub">{d.facts.hours}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="cell" href={href('contact', lang)}>
          <span class="cell__icon"><Icon name="pin" /></span>
          <span class="cell__body">
            <span class="cell__title">{d.facts.location}</span>
          </span>
          <Icon name="chevron-right" class="cell__chevron" />
        </a>
      </li>
    </ul>
  </nav>
</Sheet>

<style>
  .menu {
    display: flex;
    flex-direction: column;
  }
  .menu__label {
    margin: var(--s-5) 4px var(--s-2);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  /* Akkordeon „Leistungen“ (iOS-Stil): weiße Zelle, die sich nach unten aufklappt */
  .menu-acc {
    margin-top: var(--s-5);
    background: var(--c-white);
    border-radius: var(--r-md);
    box-shadow: var(--sh-1);
    overflow: clip;
    interpolate-size: allow-keywords;
  }
  .menu-acc::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 220ms var(--ease-out),
      content-visibility 220ms allow-discrete;
  }
  .menu-acc[open]::details-content {
    block-size: auto;
  }
  .menu-acc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 52px;
    padding: 12px 16px;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  .menu-acc__summary::-webkit-details-marker {
    display: none;
  }
  .menu-acc__summary:active {
    background: var(--c-cream);
  }
  .menu-acc__summary :global(.menu-acc__chev) {
    flex: none;
    color: var(--c-ink-muted);
    transition: transform 200ms var(--ease-out);
  }
  .menu-acc[open] .menu-acc__summary :global(.menu-acc__chev) {
    transform: rotate(180deg);
  }
  .menu-acc__body {
    padding: 0 16px 8px;
  }
  .menu-acc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-acc__item {
    padding-block: var(--s-3);
    border-top: 1px solid var(--c-line);
  }
  .menu-acc__main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: var(--tap);
    padding-block: 6px;
    color: var(--c-ink);
    text-decoration: none;
  }
  .menu-acc__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .menu-acc__main[aria-current='page'] .menu-acc__title {
    color: var(--c-gold-text);
  }
  .menu-acc__desc {
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
    overflow-wrap: anywhere;
  }
  .menu-acc__subs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-acc__subs a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding-block: 6px;
    border-top: 1px solid var(--c-line);
    color: var(--c-ink);
    font-size: var(--fs-small);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .menu-acc__all {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--s-2);
    border-top: 1px solid var(--c-line);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-acc::details-content,
    .menu-acc__summary :global(.menu-acc__chev) {
      transition: none;
    }
  }
  .menu__contact {
    margin-top: var(--s-5);
  }
  .menu .cell[aria-current='page'] .cell__title {
    color: var(--c-gold-text);
    font-weight: 500;
  }
</style>
