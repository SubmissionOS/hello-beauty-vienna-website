---
/**
 * Preisgruppen: ab 768 px als zugängliche Tabelle, darunter als iOS-Listen-Zellen.
 * Die jeweils andere Darstellung ist per display:none auch für Screenreader ausgeblendet.
 */
import type { Group } from '../data/services';
import type { Lang } from '../i18n/config';
import { t } from '../i18n';
import { durationLabel, priceLabel } from '../lib/format';

interface Props {
  lang: Lang;
  groups: Group[];
  level?: 'h2' | 'h3';
  idPrefix?: string;
}
const { lang, groups, level = 'h3', idPrefix = 'pg' } = Astro.props;
const d = t(lang);
const H = level;
---
<div class="price-groups">
  {
    groups.map((g) => (
      <div class="price-group">
        <H class="price-group__title" id={`${idPrefix}-${g.id}`}>
          {g.title[lang]}
        </H>
        {g.note && <p class="price-group__note">{g.note[lang]}</p>}

        <table class="price-table">
          <caption class="visually-hidden">{g.title[lang]}</caption>
          <thead>
            <tr>
              <th scope="col">{d.pricesPage.service}</th>
              <th scope="col" class="num">{d.pricesPage.duration}</th>
              <th scope="col" class="num">{d.pricesPage.price}</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((x) => (
              <tr>
                <th scope="row">{x.name[lang]}</th>
                <td class="num muted">{durationLabel(x, lang)}</td>
                <td class="num price">{priceLabel(x, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <ul class="cells price-cells" role="list">
          {g.items.map((x) => (
            <li class="cell">
              <span class="cell__body">
                <span class="cell__title">{x.name[lang]}</span>
                {durationLabel(x, lang) && <span class="cell__sub">{durationLabel(x, lang)}</span>}
              </span>
              <span class="cell__value price">{priceLabel(x, lang)}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .price-groups {
    display: grid;
    gap: var(--s-7);
  }

  .price-group__title {
    font-size: clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem);
    margin-bottom: var(--s-3);
  }

  .price-group__note {
    margin: calc(var(--s-2) * -1) 0 var(--s-3);
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
  }

  .price {
    color: var(--c-ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .price-cells .cell {
    align-items: flex-start;
  }

  .price-cells .cell__value {
    padding-top: 1px;
    max-width: 46%;
    white-space: normal;
    text-align: right;
  }

  .price-table {
    display: none;
    width: 100%;
    border-collapse: collapse;
    background: var(--c-white);
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: var(--sh-1);
  }

  @media (min-width: 768px) {
    .price-table {
      display: table;
    }
    .price-cells {
      display: none;
    }
  }

  .price-table th,
  .price-table td {
    padding: 13px 18px;
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--c-line);
  }

  .price-table thead th {
    border-top: 0;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    background: var(--c-paper);
    padding-block: 10px;
  }

  .price-table tbody th {
    font-weight: 400;
  }

  .price-table .num {
    text-align: right;
    white-space: nowrap;
    width: 1%;
    font-variant-numeric: tabular-nums;
  }

  .price-table tbody tr:hover {
    background: var(--c-paper);
  }
</style>
