---
/**
 * Preisgruppen: ab 768 px als zugängliche Tabelle, darunter als iOS-Listen-Zellen.
 * Die jeweils andere Darstellung ist per display:none auch für Screenreader ausgeblendet.
 */
import type { Group } from '../data/services';
import type { Lang } from '../i18n/config';
import { t } from '../i18n';
import { durationLabel, priceLabel } from '../lib/format';

interface Props {
  lang: Lang;
  groups: Group[];
  level?: 'h2' | 'h3';
  idPrefix?: string;
}
const { lang, groups, level = 'h3', idPrefix = 'pg' } = Astro.props;
const d = t(lang);
const H = level;
---
<div class="price-groups">
  {
    groups.map((g) => (
      <div class="price-group">
        <H class="price-group__title" id={`${idPrefix}-${g.id}`}>
          {g.title[lang]}
        </H>
        {g.note && <p class="price-group__note">{g.note[lang]}</p>}

        <table class="price-table">
          <caption class="visually-hidden">{g.title[lang]}</caption>
          <thead>
            <tr>
              <th scope="col">{d.pricesPage.service}</th>
              <th scope="col" class="num">{d.pricesPage.duration}</th>
              <th scope="col" class="num">{d.pricesPage.price}</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map((x) => (
              <tr>
                <th scope="row">{x.name[lang]}</th>
                <td class="num muted">{durationLabel(x, lang)}</td>
                <td class="num price">{priceLabel(x, lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <ul class="cells price-cells" role="list">
          {g.items.map((x) => (
            <li class="cell">
              <span class="cell__body">
                <span class="cell__title">{x.name[lang]}</span>
                {durationLabel(x, lang) && <span class="cell__sub">{durationLabel(x, lang)}</span>}
              </span>
              <span class="cell__value price">{priceLabel(x, lang)}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  /* Wie eine gedruckte Karte: keine Kästen, feine Linien, Preise in Tabellenziffern rechtsbündig */
  .price-groups {
    display: grid;
    gap: var(--s-7);
  }
  .price-group__title {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--c-gold-text);
  }
  .price-group__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--c-gold-soft);
  }
  .price-group__note {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
  }
  .price {
    color: var(--c-ink);
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }

  /* Mobil: Zeilen statt Karten */
  .price-cells {
    list-style: none;
    background: none;
    box-shadow: none;
    border-radius: 0;
  }
  .price-cells .cell {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 0;
    padding: 12px 0;
    background: none;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .price-cells .cell::after,
  .price-cells .cell::before {
    display: none;
  }
  .price-cells .cell__value {
    padding-top: 1px;
    max-width: 46%;
    white-space: normal;
    text-align: right;
  }

  .price-table {
    display: none;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }
  @media (min-width: 768px) {
    .price-table {
      display: table;
    }
    .price-cells {
      display: none;
    }
  }
  .price-table th,
  .price-table td {
    padding: 12px 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .price-table td + td,
  .price-table th + th {
    padding-left: var(--s-5);
  }
  .price-table thead th {
    padding-block: 0 8px;
    border-bottom: 1px solid var(--c-ink);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }
  .price-table tbody th {
    font-weight: 400;
  }
  .price-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .price-table thead th:nth-child(2) {
    width: 10.5rem;
  }
  .price-table thead th:nth-child(3) {
    width: 9.5rem;
  }
  .price-table td.num {
    white-space: normal;
  }
</style>
