---
import Img from './Img.astro';
import Icon from './Icon.astro';
import { categories, priceRange, type CategoryId } from '../data/services';
import { href, SERVICE_PAGES } from '../i18n/routes';
import type { Lang } from '../i18n/config';
import { fmt, t } from '../i18n';
import { euro } from '../lib/format';

interface Props {
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}
const { lang, headingLevel = 'h3' } = Astro.props;
const d = t(lang);
const H = headingLevel;
const imageFor: Record<CategoryId, { name: string; pos?: string }> = {
  nails: { name: 'naegel-milchweiss-mandel', pos: '50% 40%' },
  manicure: { name: 'naegel-bordeaux-klassisch', pos: '50% 55%' },
  pedicure: { name: 'pedikuere-behandlung-salon', pos: '62% 50%' },
  facial: { name: 'kosmetik-gesichtsmaske', pos: '45% 50%' },
  lashes: { name: 'wimpern-volumen-ergebnis-gruen', pos: '50% 45%' },
  hair: { name: 'haarentfernung-laser-liege', pos: '50% 60%' },
};
---
<ul class="service-grid" role="list">
  {
    categories.map((c) => {
      const r = priceRange(c.id);
      const img = imageFor[c.id];
      return (
        <li class="service-card reveal">
          <a class="service-card__link" href={href(SERVICE_PAGES[c.id], lang)}>
            <Img name={img.name} alt={d.cards[c.id].imageAlt} ratio="4 / 3" sizes="(min-width: 1200px) 380px, (min-width: 640px) 46vw, 92vw" {...(img.pos ? { position: img.pos } : {})} widths={[360, 540, 720, 960]} />
            <span class="service-card__body">
              <H class="service-card__title">{d.cards[c.id].title}</H>
              <span class="service-card__text">{d.cards[c.id].text}</span>
              <span class="service-card__meta">
                <span class="service-card__price">
                  {fmt(d.units.from, { price: euro(r.min, lang) })}
                </span>
                <span class="service-card__more" aria-hidden="true">
                  <Icon name="arrow-right" size={20} />
                </span>
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .service-grid {
    list-style: none;
    display: grid;
    gap: var(--s-5);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .service-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--c-ink);
    text-decoration: none;
    background: var(--c-white);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-1);
    overflow: hidden;
    transition:
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }
  .service-card__link :global(.img) {
    border-radius: 0;
  }
  .service-card__link :global(img) {
    transition: transform 600ms var(--ease-out);
  }
  @media (hover: hover) {
    .service-card__link:hover {
      box-shadow: var(--sh-2);
      color: var(--c-ink);
    }
    .service-card__link:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .service-card__link:active {
    transform: scale(0.99);
  }
  .service-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--s-2);
    padding: var(--s-5);
  }
  .service-card__title {
    font-size: var(--fs-h3);
  }
  .service-card__text {
    color: var(--c-ink-muted);
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .service-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--s-4);
  }
  .service-card__price {
    font-weight: 500;
    color: var(--c-gold-text);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .service-card__more {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c-cream);
    color: var(--c-gold-text);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }
  @media (hover: hover) {
    .service-card__link:hover .service-card__more {
      background: var(--c-gold-text);
      color: var(--c-white);
    }
  }
</style>
