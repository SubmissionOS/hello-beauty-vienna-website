---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';
import LangSheet from '../components/LangSheet.astro';
import MenuSheet from '../components/MenuSheet.astro';
import { LANG_META, LOCALES, type Lang } from '../i18n/config';
import { routes, type RouteKey } from '../i18n/routes';
import { t } from '../i18n';
import { image } from '../data/images';
import { abs, graph, salonNode, websiteNode, webPageNode } from '../lib/schema';
import { demoMode } from '../lib/env';

interface Props {
  lang: Lang;
  /** null für Fehlerseiten (keine hreflang-Paare, noindex) */
  routeKey: RouteKey | null;
  title: string;
  description: string;
  /** Salonbild für Open Graph (1200×630) */
  ogImage?: string;
  ogAlt?: string;
  crumbs?: { key: RouteKey; name: string; url: string }[];
  schema?: Record<string, unknown>[];
  pageType?: string;
  hideBar?: boolean;
  /** Bild, das als LCP vorgeladen wird (Hero) */
  preloadImage?: { href: string; srcset: string; sizes: string; type: string } | undefined;
}

const { lang, routeKey, title, description, ogImage = 'salon-empfang-hb-monogramm', ogAlt, crumbs, schema = [], pageType, hideBar = false, preloadImage } = Astro.props;
const d = t(lang);
const meta = LANG_META[lang];
const canonical = abs(Astro.url.pathname);
const noindex = routeKey === null || demoMode;

const alternates = routeKey
  ? LOCALES.map((l) => ({ hreflang: LANG_META[l].hreflang, href: abs(routes[routeKey].path[l]) }))
  : [];

const og = await getImage({ src: image(ogImage), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const logo = await getImage({ src: image('logo-hb-hello-beauty-gold'), width: 600, format: 'png' });
const ogUrl = abs(og.src);

const nodes = [
  salonNode(lang, ogUrl, abs(logo.src)),
  websiteNode(),
  webPageNode({ url: canonical, name: title, description, lang, ...(pageType ? { type: pageType } : {}), ...(crumbs ? { crumbs } : {}) }),
  ...schema,
];
---
<!doctype html>
<html lang={meta.htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={demoMode ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {routeKey && <link rel="alternate" hreflang="x-default" href={abs(routes[routeKey].path.de)} />}

    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} type={preloadImage.type} fetchpriority="high" />}

    <meta name="theme-color" content="#fbf9f4" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={d.meta.siteName} />
    <meta property="og:locale" content={meta.ogLocale} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? d.meta.defaultOgAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={graph(nodes)} />
  </head>
  <body class:list={[{ 'has-bar': !hideBar }]} data-lang={lang}>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <Header lang={lang} routeKey={routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {!hideBar && <BottomBar lang={lang} />}
    <MenuSheet lang={lang} routeKey={routeKey} />
    <LangSheet lang={lang} routeKey={routeKey} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
