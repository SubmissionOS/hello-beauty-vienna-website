{
  "name": "hellobeauty-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:types": "tsc --noEmit",
    "build": "node scripts/check-i18n.mjs && astro build",
    "preview": "astro preview --port 4321",
    "test": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "astro": "7.3.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "lighthouse": "13.5.0",
    "typescript": "7.0.2"
  }
}
